  "description": "Backend API for Tirth Yatra App with JWT Role-based Authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "build:local": "NODE_ENV=development node server.js",
    "build:prod": "NODE_ENV=production node server.js",
    "migrate": "node scripts/migrate-no-password.js",
    "migrate:no-password": "node scripts/migrate-no-password.js",
