{
  "name": "tirth-yatra-backend",
  "version": "1.0.0",
  "description": "Backend API for Tirth Yatra App with JWT Role-based Authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:local": "NODE_ENV=development node server.js",
    "build:prod": "NODE_ENV=production node server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:demo": "DB_NAME=tirthyatra_demo node scripts/migrate.js",
    "reset-db": "node scripts/reset-database.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mysql2": "^3.6.0",
    "sequelize": "^6.32.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": ["jwt", "authentication", "roles", "permissions", "tirth-yatra"],
  "author": "Tirth Yatra Team",
  "license": "MIT"
}
